{
  "name": "@printerops/api",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "npm run build && npm run build:web && npm run copy:static && esbuild dist/server.js --bundle --platform=node --target=node20 --outfile=dist/server.bundle.cjs --format=cjs && node -e \"var f=require('fs');var w=require.resolve('sql.js/dist/sql-wasm.wasm');f.copyFileSync(w,'dist/sql-wasm.wasm')\" && pkg dist/server.bundle.cjs --targets node18-win-x64 --output dist/server.exe",
    "build:web": "cd ../web && npm run build",
    "copy:static": "node -e \"var fs=require('fs');var p=require('path');var src='../web/dist';var dst='dist/static';fs.rmSync(dst,{recursive:true,force:true});fs.cpSync(src,dst,{recursive:true});console.log('static copied:',fs.readdirSync(dst))\""
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/static": "^7.0.4",
    "@printerops/adapters": "*",
    "@printerops/domain": "*",
    "@printerops/shared": "*",
    "bwip-js": "^4.11.2",
    "fastify": "^4.28.1",
    "nats": "^2.29.3",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.1",
    "pkg": "^5.8.1",
    "tsx": "^4.15.7",
    "vitest": "^1.6.0"
  },
  "pkg": {
    "assets": [
      "dist/sql-wasm.wasm",
      "dist/static"
    ]
  }
}
