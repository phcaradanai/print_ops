{
  "name": "@printerops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "tsc -p tsconfig.json && esbuild dist/server.js --bundle --platform=node --target=node20 --outfile=dist/server.bundle.cjs --format=cjs --external:sql.js && node -e \"var f=require('fs');var w=require.resolve('sql.js/dist/sql-wasm.wasm');f.copyFileSync(w,'dist/sql-wasm.wasm')\""
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@printerops/adapters": "*",
    "@printerops/domain": "*",
    "@printerops/shared": "*",
    "fastify": "^4.28.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.1",
    "tsx": "^4.15.7",
    "vitest": "^1.6.0"
  }
}
