{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrinterOps",
  "version": "0.0.1",
  "identifier": "com.printerops.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w apps/web",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build -w apps/web",
    "frontendDist": "../../apps/web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PrinterOps",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
