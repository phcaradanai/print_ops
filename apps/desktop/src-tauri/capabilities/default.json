{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability granted to the main PrinterOps window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:31415/*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-write-export-file",
    "allow-get-nats-settings",
    "allow-save-nats-settings",
    "shell:allow-execute",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "node",
          "cmd": "node",
          "args": true
        },
        {
          "name": "printops-runner",
          "cmd": "printops-runner",
          "args": true
        }
      ]
    },
    "shell:allow-stdin-write"
  ]
}
