{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability granted to the main PrinterOps window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "shell:allow-execute",
    "shell:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "node",
          "cmd": "node",
          "args": true
        },
        {
          "name": "printops-runner",
          "cmd": "printops-runner",
          "args": true
        }
      ]
    },
    "shell:allow-stdin-write"
  ]
}
