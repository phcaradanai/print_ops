# Environment for infra/docker/docker-compose.app.stack.yml.
# Copy to a protected file on the server (chmod 600) and fill in the secret.

# Image tag at registry.pg.xenex.io/printops-app
PRINTOPS_APP_VERSION=0.1.45

# Required. Generate once per installation: openssl rand -hex 32
# Changing it later signs out every user.
PRINTOPS_APP_JWT_SECRET=

# Listener. Keep loopback and put the app behind the HTTPS reverse proxy.
PRINTOPS_APP_BIND_ADDRESS=127.0.0.1
PRINTOPS_APP_PORT=8081

# Optional: only needed if a separate Go runner enrolls against this app.
PRINTOPS_RUNNER_BOOTSTRAP_SECRET=

# Job history retention (this gateway is not the system of record; keep short).
PRINTOPS_RETENTION_DAYS=7
PRINTOPS_RETENTION_MAX_ROWS=1000
