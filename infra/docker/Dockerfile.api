# PrintOps API — production image
# Build context: print_ops/ root
FROM node:22-alpine AS build
WORKDIR /app

# Copy workspace config + all packages/apps needed for build
COPY package.json package-lock.json tsconfig.json ./
COPY packages/domain ./packages/domain
COPY packages/shared ./packages/shared
COPY packages/adapters ./packages/adapters
COPY apps/api ./apps/api

RUN npm ci --no-audit --no-fund
RUN npm run build -w packages/domain
RUN npm run build -w packages/shared
RUN npm run build -w packages/adapters
RUN npm run build -w apps/api

# Production stage
FROM node:22-alpine
WORKDIR /app

RUN addgroup -S printops && adduser -S printops -G printops

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/domain/dist ./packages/domain/dist
COPY --from=build /app/packages/domain/package.json ./packages/domain/
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/
COPY --from=build /app/packages/adapters/dist ./packages/adapters/dist
COPY --from=build /app/packages/adapters/package.json ./packages/adapters/
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/

USER printops
EXPOSE 3001

ENV NODE_ENV=production
CMD ["node", "apps/api/dist/server.js"]
