# Generate a unique production secret with: openssl rand -hex 32
PRINTOPS_CONTROL_JWT_SECRET=

# Release artifact storage: choose "minio" (default) or "local".
PRINTOPS_RELEASE_STORAGE_PROVIDER=minio
# Docker Compose activates the matching profile when you use this env file.
COMPOSE_PROFILES=${PRINTOPS_RELEASE_STORAGE_PROVIDER:-minio}

# Required only when PRINTOPS_RELEASE_STORAGE_PROVIDER=minio.
# Generate a separate unique secret with: openssl rand -hex 32
PRINTOPS_MINIO_ACCESS_KEY=printops-control
PRINTOPS_MINIO_SECRET_KEY=

# Use the server's private/VPN address, reachable from every enrolled client.
# Restrict TCP 4222 to trusted client/VPN networks at the server firewall.
PRINTOPS_CONTROL_PUBLIC_NATS_URL=
PRINTOPS_CONTROL_NATS_BIND_ADDRESS=
PRINTOPS_CONTROL_NATS_PORT=4222

# Keep the web container on loopback when using a TLS reverse proxy on the host.
PRINTOPS_WEB_BIND_ADDRESS=127.0.0.1
PRINTOPS_WEB_PORT=8080

# Optional HTTP(S) origin reachable by PrintOps clients, including the published port.
# Set explicitly behind a TLS proxy or when client DNS differs from browser DNS.
# Example: http://printops.node1.ch3.local or http://10.20.0.5:8080
PRINTOPS_CONTROL_PUBLIC_HTTP_URL=

# Optional list of station origins this host can reach but cannot enroll, comma
# separated (e.g. "http://app:3001,http://lab-2:3001"). Stations found by enrollment
# or announce are pulled from automatically, so this normally stays empty.
PRINTOPS_CONTROL_DISCOVERY_TARGETS=

# Optional shared secret, required only for pulling stations that are not enrolled.
# An enrolled station authenticates with a credential both sides derive from its
# device token, so a fully enrolled fleet needs no value here. Generate with
# `openssl rand -hex 32` and set the SAME value on any station that needs it.
PRINTOPS_CONTROL_PULL_TOKEN=

# API service DNS name and port reachable by the web container on a shared Docker network.
PRINTOPS_API_UPSTREAM=api:3001

# Positive whole MiB for the Base64 JSON import request, shared by API and Web.
PRINTOPS_RELEASE_IMPORT_MAX_MIB=128

# Control Plane version, independent of the PrintOps app version; also used as the image tag.
PRINTOPS_CONTROL_PLANE_VERSION=1.0.11

# Optional repository prefix for image refs; unset uses the local default name.
# PRINTOPS_IMAGE_PREFIX=ghcr.io/my-org/printops-control-plane
