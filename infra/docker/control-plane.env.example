# Generate a unique production secret with: openssl rand -hex 32
PRINTOPS_CONTROL_JWT_SECRET=

# Release artifact storage: choose "minio" (default) or "local".
PRINTOPS_RELEASE_STORAGE_PROVIDER=minio
# Docker Compose activates the matching profile when you use this env file.
COMPOSE_PROFILES=${PRINTOPS_RELEASE_STORAGE_PROVIDER:-minio}

# Required only when PRINTOPS_RELEASE_STORAGE_PROVIDER=minio.
# Generate a separate unique secret with: openssl rand -hex 32
PRINTOPS_MINIO_ACCESS_KEY=printops-control
PRINTOPS_MINIO_SECRET_KEY=

# Use the server's private/VPN address, reachable from every enrolled client.
# Restrict TCP 4222 to trusted client/VPN networks at the server firewall.
PRINTOPS_CONTROL_PUBLIC_NATS_URL=
PRINTOPS_CONTROL_NATS_BIND_ADDRESS=
PRINTOPS_CONTROL_NATS_PORT=4222

# Keep the web container on loopback when using a TLS reverse proxy on the host.
PRINTOPS_WEB_BIND_ADDRESS=127.0.0.1
PRINTOPS_WEB_PORT=8080

# Control Plane version, independent of the PrintOps app version; also used as the image tag.
PRINTOPS_CONTROL_PLANE_VERSION=1.0.0

# Optional repository prefix for image refs; unset uses the local default name.
# PRINTOPS_IMAGE_PREFIX=ghcr.io/my-org/printops-control-plane
