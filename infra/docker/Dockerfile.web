# PrintOps Web Dashboard — production image
# Build context: print_ops/ root
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.json ./
COPY packages/domain ./packages/domain
COPY packages/shared ./packages/shared
COPY packages/adapters ./packages/adapters
COPY apps/web ./apps/web

RUN npm ci --no-audit --no-fund
RUN npm run build -w packages/domain
RUN npm run build -w packages/shared
ARG VITE_CONTROL_PLANE_VERSION=1.0.0
RUN VITE_CONTROL_APP=true VITE_CONTROL_PLANE_VERSION=${VITE_CONTROL_PLANE_VERSION} npm run build -w apps/web

# Serve with nginx
FROM nginx:alpine

ENV PRINTOPS_API_UPSTREAM=api:3001 \
    NGINX_ENVSUBST_FILTER=^PRINTOPS_API_UPSTREAM

COPY apps/web/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80
