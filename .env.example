# =============================================================================
# PrintOps environment template — local development defaults
#
# Copy to .env and adjust for your environment:
#   cp .env.example .env
#
# PRODUCTION: secrets/tokens MUST come from your deployment secret store
# (env, HashiCorp Vault, sealed secrets, etc.). Never commit real values.
# =============================================================================

# ---- API server -----------------------------------------------------------

# Port the API server listens on
PORT=3001

# Bind host (0.0.0.0 for container / LAN; 127.0.0.1 for local-only)
HOST=0.0.0.0

# JWT signing secret — replace with a strong random string in production
JWT_SECRET=dev-secret-change-in-production

# Dev API key for /api/v1 external endpoints (X-Api-Key header)
PRINTOPS_DEV_API_KEY=printops-dev-apikey-2026

# ---- TypeScript runner -----------------------------------------------------

# API base URL the runner connects to
API_URL=http://localhost:3001

# Runner token — when empty, the runner logs in with dev credentials below
RUNNER_API_TOKEN=

# Display name registered with the API
RUNNER_NAME=runner-local

# Runner host metadata
HOSTNAME=localhost

# Protocols the runner advertises (comma-separated)
SUPPORTED_PROTOCOLS=fake,ipp,cups

# Poll / heartbeat / discovery intervals (milliseconds)
POLL_INTERVAL_MS=2000
HEARTBEAT_INTERVAL_MS=10000
DISCOVERY_INTERVAL_MS=60000

# Discovery adapter: auto | windows | macos | fake
DISCOVERY_ADAPTER=auto

# Dev login credentials — used only when RUNNER_API_TOKEN is empty
RUNNER_DEV_EMAIL=admin@printerops.local
RUNNER_DEV_PASSWORD=dev-password

# ---- Go runner (apps/runner-go) --------------------------------------------
# The Go runner reads env vars prefixed with PRINTOPS_ or from a config file.
# Env vars take precedence over the config file.

# API base URL
PRINTOPS_API_BASE_URL=http://localhost:3001

# Unique runner identifier — optional, generated by the API on registration
# PRINTOPS_RUNNER_ID=

# Display name registered with the API (default: printops-go-runner)
PRINTOPS_RUNNER_NAME=printops-go-runner

# Runner token — when empty, the runner logs in with dev credentials below
PRINTOPS_RUNNER_TOKEN=

# Discovery mode: auto | windows | macos | fake
PRINTOPS_DISCOVERY_MODE=auto

# Executor mode: fake | windows-spooler | cups | rawtcp
PRINTOPS_EXECUTOR_MODE=fake

# Poll / heartbeat / discovery intervals (milliseconds)
PRINTOPS_POLL_INTERVAL_MS=750
PRINTOPS_HEARTBEAT_INTERVAL_MS=15000
PRINTOPS_DISCOVERY_INTERVAL_MS=60000

# Log level: debug | info | warn | error
PRINTOPS_LOG_LEVEL=info

# Hostname override (default: OS hostname)
PRINTOPS_HOSTNAME=

# Dev login credentials — used only when PRINTOPS_RUNNER_TOKEN is empty
PRINTOPS_DEV_EMAIL=admin@printerops.local
PRINTOPS_DEV_PASSWORD=dev-password

# Optional KEY=VALUE config file path (env vars take precedence)
# PRINTOPS_CONFIG_FILE=

# ---- Fake executor (Go runner) ---------------------------------------------
# Simulated print latency in milliseconds (default: 50)
# PRINTOPS_FAKE_LATENCY_MS=50

# Force every fake job to fail (for testing error handling)
# PRINTOPS_FAKE_FORCE_FAIL=false

# ---- Web dashboard (Vite) --------------------------------------------------

# Production / Tauri API base URL.
# In dev mode the Vite proxy handles /api → http://localhost:3001.
# VITE_API_BASE is only read when import.meta.env.DEV is false.
# VITE_API_BASE=http://127.0.0.1:3001

# ---- SQLite persistence (optional) -----------------------------------------
# Set DB_MODE=sqlite to use SQLite instead of in-memory storage.
# When using SQLite, the remaining vars control DB/WASM file locations.

# Storage mode: memory (default) | sqlite
DB_MODE=memory

# SQLite database file path (default: ./printops.db relative to cwd)
# PRINTOPS_DB_PATH=./data/printops.db

# sql.js WASM file path override (default: auto-discover alongside executable)
# SQL_WASM_PATH=

# ---- Static frontend serving (API server) ----------------------------------
# When set, the API server serves a static frontend from this directory.
# Used by the Tauri desktop app for same-origin delivery.
# STATIC_DIR=
